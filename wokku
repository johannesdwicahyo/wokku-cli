  api(:post, "/apps/#{id}/domains", { hostname: domain })
  puts "Added domain: #{domain}"
end

# Look up a domain row by hostname so users can type the name they know
# instead of an internal id. Returns the row or nil.
def find_domain(app_id, hostname)
  list = api(:get, "/apps/#{app_id}/domains")
  return nil unless list.is_a?(Array)
  list.find { |d| d["hostname"] == hostname }
end

register "domains:remove", "Remove a domain (usage: wokku domains:remove APP_ID DOMAIN)" do
  id = ARGV.shift || abort("Usage: wokku domains:remove APP_ID DOMAIN")
  domain = ARGV.shift || abort("Missing domain name")
  row = find_domain(id, domain) || abort("No domain '#{domain}' on app #{id}")
  api(:delete, "/apps/#{id}/domains/#{row['id']}")
  puts "Removed domain: #{domain}"
end

register "domains:clear", "Remove every custom domain on an app (usage: wokku domains:clear APP_ID)" do
  id = ARGV.shift || abort("Usage: wokku domains:clear APP_ID")
  list = api(:get, "/apps/#{id}/domains")
  abort "No domains on app #{id}" unless list.is_a?(Array) && list.any?
  list.each do |d|
    api(:delete, "/apps/#{id}/domains/#{d['id']}")
    puts "Removed: #{d['hostname']}"
  end
end

register "certs:enable", "Enable Let's Encrypt SSL on a domain (usage: wokku certs:enable APP_ID DOMAIN)" do
  id = ARGV.shift || abort("Usage: wokku certs:enable APP_ID DOMAIN")
  domain = ARGV.shift || abort("Missing domain name")
  row = find_domain(id, domain) || abort("No domain '#{domain}' on app #{id} — add it first with wokku domains:add")
  api(:post, "/apps/#{id}/domains/#{row['id']}/ssl")
  puts "SSL enabled for #{domain}"
end

